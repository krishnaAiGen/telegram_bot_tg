# .env

# --- REQUIRED: OpenAI Configuration ---
OPENAI_API_KEY="sk-your-openai-api-key-here"

# --- REQUIRED: Firebase Configuration ---
FIREBASE_CRED_PATH="/path/to/your/firebase-credentials.json"

# --- REQUIRED: Telegram Channel Configuration ---
TELEGRAM_SOURCE_CHANNEL="name_of_channel_to_listen_to"
TELEGRAM_DESTINATION_CHANNEL="name_of_channel_to_send_to"

# --- REQUIRED: Telegram User Accounts (Names MUST match characters.json) ---
TELEGRAM_USER_JOIN9911_API_ID="12345678"
TELEGRAM_USER_JOIN9911_API_HASH="your_api_hash_for_join9911"

TELEGRAM_USER_DAVETHM_API_ID="87654321"
TELEGRAM_USER_DAVETHM_API_HASH="your_api_hash_for_davethm"

# --- OPTIONAL: Other Integrations ---
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/..."
FARCASTER_MNEMONIC="word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12"
FARCASTER_FID="12345"