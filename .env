TELEGRAM_USER_JoiN9911_API_HASH="api_hash_for_join9911"

TELEGRAM_USER_davethm_API_ID="87654321"
TELEGRAM_USER_davethm_API_HASH="api_hash_for_davethm"

# --- OPTIONAL: Other Integrations ---
